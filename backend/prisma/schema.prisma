
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONSUMER
  FOUNDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Category {
  FOOD_BEVERAGE
  FASHION
  BEAUTY
  ELECTRONICS
  HOME_LIVING
  HEALTH_WELLNESS
  TOYS_KIDS
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(CONSUMER)
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  founderProfile  FounderProfile?
  consumerProfile ConsumerProfile?

  // One founder can own multiple products
  products        Product[]
  votes             Vote[]
intents           PurchaseIntent[]
likes             Like[]
comments          Comment[]
waitlistEntries   WaitlistEntry[]
  @@map("users")
}

model FounderProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  description        String?
  website            String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("founder_profiles")
}

model ConsumerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests   String[]
  city        String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("consumer_profiles")
}

model Product {
  id          String         @id @default(uuid())
  founderId   String
  founder     User           @relation(fields: [founderId], references: [id], onDelete: Cascade)
  name        String
  description String
  category    Category
  images      ProductImage[]
  campaigns   Campaign[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([founderId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String   @unique
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Campaign {
  id             String            @id @default(uuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  status         CampaignStatus    @default(DRAFT)
  objective      String?
  targetAudience String?
  location       String?
  durationDays   Int
  publishedAt    DateTime?
  endsAt         DateTime?
  closedAt       DateTime?
  variants       CampaignVariant[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  votes     Vote[]
intents   PurchaseIntent[]
likes     Like[]
comments  Comment[]
waitlist  WaitlistEntry[]
views     CampaignView[]
  @@index([status, endsAt])
  @@index([productId])
  @@map("campaigns")
}

model CampaignVariant {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  description String?
  pricePaise  Int
  position    Int      @default(0)
  votes    Vote[]
intents  PurchaseIntent[]
  @@index([campaignId])
  @@map("campaign_variants")
}

enum IntentLevel {
  DEFINITELY
  PROBABLY
  MAYBE
  NO
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

model Vote {
  id         String          @id @default(uuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId  String
  variant    CampaignVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([campaignId, userId])
  @@index([variantId])
  @@map("votes")
}

model PurchaseIntent {
  id         String          @id @default(uuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId  String
  variant    CampaignVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  level      IntentLevel
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, variantId])
  @@index([campaignId])
  @@map("purchase_intents")
}

model Like {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, userId])
  @@map("likes")
}

model Comment {
  id         String        @id @default(uuid())
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  status     CommentStatus @default(VISIBLE)
  createdAt  DateTime      @default(now())

  @@index([campaignId, createdAt])
  @@map("comments")
}

model WaitlistEntry {
  id                  String   @id @default(uuid())
  campaignId          String
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentToShareEmail Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@unique([campaignId, userId])
  @@map("waitlist_entries")
}

model CampaignView {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewerKey  String
  day        String
  createdAt  DateTime @default(now())

  @@unique([campaignId, viewerKey, day])
  @@map("campaign_views")
}
