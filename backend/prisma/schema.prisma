
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONSUMER
  FOUNDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Category {
  FOOD_BEVERAGE
  FASHION
  BEAUTY
  ELECTRONICS
  HOME_LIVING
  HEALTH_WELLNESS
  TOYS_KIDS
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(CONSUMER)
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  founderProfile  FounderProfile?
  consumerProfile ConsumerProfile?

  // One founder can own multiple products
  products        Product[]

  @@map("users")
}

model FounderProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  description        String?
  website            String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("founder_profiles")
}

model ConsumerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests   String[]
  city        String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("consumer_profiles")
}

model Product {
  id          String         @id @default(uuid())
  founderId   String
  founder     User           @relation(fields: [founderId], references: [id], onDelete: Cascade)
  name        String
  description String
  category    Category
  images      ProductImage[]
  campaigns   Campaign[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([founderId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String   @unique
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Campaign {
  id             String            @id @default(uuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  status         CampaignStatus    @default(DRAFT)
  objective      String?
  targetAudience String?
  location       String?
  durationDays   Int
  publishedAt    DateTime?
  endsAt         DateTime?
  closedAt       DateTime?
  variants       CampaignVariant[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, endsAt])
  @@index([productId])
  @@map("campaigns")
}

model CampaignVariant {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  description String?
  pricePaise  Int
  position    Int      @default(0)

  @@index([campaignId])
  @@map("campaign_variants")
}
